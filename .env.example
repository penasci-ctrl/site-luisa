# Copie para .env e preencha (na Cloudflare, cadastre as mesmas variáveis no painel do projeto)
# Sem SANITY_PROJECT_ID o site usa o conteúdo inicial de src/data/seed.mjs
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Só para importar o conteúdo inicial (token com permissão de escrita, gerado em sanity.io/manage)
SANITY_WRITE_TOKEN=
